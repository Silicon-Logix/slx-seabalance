export GDK_BACKEND=wayland
# OpenSTLinux exposes its systemd-managed Weston socket here.
export XDG_RUNTIME_DIR="/run/user/$(id -u)"
export WAYLAND_DISPLAY=wayland-0

while true; do
    /usr/bin/slx-seabalance-panel --status /run/slx-seabalance --fullscreen \
        --logo /usr/share/slx-seabalance/SLX_Official_Logo.png
    sleep 2
done
