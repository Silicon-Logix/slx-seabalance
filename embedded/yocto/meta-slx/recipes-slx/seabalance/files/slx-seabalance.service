[Unit]
Description=SLX SeaBalance controller
After=network.target

[Service]
Type=simple
User=seabalance
Group=weston
StateDirectory=slx-seabalance
StateDirectoryMode=0750
RuntimeDirectory=slx-seabalance
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=restart
EnvironmentFile=/etc/slx-seabalance/service.env
ExecStart=@BINDIR@/slx-seabalance-controller --bind ${SLX_BIND} --port ${SLX_PORT} --state /var/lib/slx-seabalance --status /run/slx-seabalance --core @LIBDIR@/slx-seabalance/libslx_seabalance_control.so
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_UNIX
UMask=0007

[Install]
WantedBy=multi-user.target
